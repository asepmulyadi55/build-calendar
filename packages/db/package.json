{
  "name": "@buildcalendar/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "seed": "dotenv -e ../../.env -- tsx src/seed.ts",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "templates": "tsx scripts/make-templates.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@buildcalendar/calendar-core": "workspace:*"
  },
  "devDependencies": {
    "dotenv-cli": "11.0.0",
    "prisma": "6.19.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
