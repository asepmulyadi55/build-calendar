// BuildCalendar database schema.
//
// Scope note: this is the P1-US-001 skeleton. It contains only the reference tables
// the seed needs (`docs/02-phase-1-mvp.md` P1-US-001). The transactional tables from
// `docs/00-master-spec.md` §8 — coin_transactions, payments, projects, project_assets,
// export_jobs, orders, addresses, regions, audit_logs — are added by the stories that
// own them, each with its own migration.
//
// Every table added here MUST enable RLS with a deny-all policy in the same migration.
// `pnpm check:rls` fails the build otherwise. See `01-…` §5.3.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Pooled connection (PgBouncer, 6543) for the application.
  url = env("DATABASE_URL")
  // Direct connection (5432) for migrations. Migrating through the pooler misbehaves.
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  user
  admin

  @@map("user_role")
}

enum ProjectStatus {
  draft
  unlocking
  unlocked

  @@map("project_status")
}

enum HolidayType {
  national
  joint_leave
  religious
  international

  @@map("holiday_type")
}

/// Bridge to Supabase Auth. `auth.users` is owned by Supabase and is not modelled here;
/// the foreign key and the insert trigger are added in raw SQL by the migration (§5.4).
model Profile {
  id               String    @id @db.Uuid
  name             String?
  phone            String?
  role             UserRole  @default(user)
  /// Cache only. The ledger in `coin_transactions` is the source of truth (BR-C05).
  coinBalanceCache Int       @default(0) @map("coin_balance_cache")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Set when the owner requests deletion. The row survives so financial records
  /// can be anonymised rather than orphaned; a purge job removes photos, projects
  /// and exports within 7 days (NFR-P03).
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([deletedAt])
  projects Project[]
  assets   ProjectAsset[]

  @@map("profiles")
}

model CoinPackage {
  id         String  @id @default(uuid()) @db.Uuid
  name       String
  /// Rupiah, integer. Indonesia has no minor unit in practice.
  priceIdr   Int     @map("price_idr")
  coinAmount Int     @map("coin_amount")
  isActive   Boolean @default(true) @map("is_active")
  sortOrder  Int     @default(0) @map("sort_order")
  badge      String?

  @@map("coin_packages")
}

model ProductPreset {
  id                 String  @id @default(uuid()) @db.Uuid
  code               String  @unique
  name               String
  /// Trim size in millimetres. Bleed is added on every side at export time (AR-04).
  widthMm            Int     @map("width_mm")
  heightMm           Int     @map("height_mm")
  orientation        String
  sheetCount         Int     @map("sheet_count")
  monthsPerSheet     Int     @map("months_per_sheet")
  hasCover           Boolean @default(false) @map("has_cover")
  bleedMm            Int     @map("bleed_mm")
  safeMarginMm       Int     @map("safe_margin_mm")
  unlockCostCoins    Int     @map("unlock_cost_coins")
  /// Phase 2 (print orders) needs this. 0 until the owner weighs real stock.
  weightGramPerSheet Int     @default(0) @map("weight_gram_per_sheet")
  printBasePrice     Int     @default(0) @map("print_base_price")
  isActive           Boolean @default(true) @map("is_active")

  templates Template[]
  projects  Project[]

  @@map("product_presets")
}

model Template {
  id              String  @id @default(uuid()) @db.Uuid
  name            String
  slug            String  @unique
  productPresetId String  @map("product_preset_id") @db.Uuid
  category        String
  /// Object-storage keys, never URLs. URLs are signed at request time (AR-07).
  thumbnailKey    String? @map("thumbnail_key")
  designKey       String  @map("design_key")
  slotSchema      Json    @map("slot_schema")
  isPremium       Boolean @default(false) @map("is_premium")
  isActive        Boolean @default(false) @map("is_active")
  sortOrder       Int     @default(0) @map("sort_order")

  productPreset ProductPreset @relation(fields: [productPresetId], references: [id])
  projects      Project[]

  @@index([productPresetId])
  @@map("templates")
}

/// A user's calendar.
///
/// `designJson` is a **copy** of the template's design taken at selection time, never
/// a reference (P1-US-302). A later edit to the template must not alter a calendar
/// somebody already built — and once unlocked, that calendar is something they paid
/// for.
model Project {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  title           String
  productPresetId String        @map("product_preset_id") @db.Uuid
  /// Which template it started from, for reporting only. The design is already copied.
  templateId      String?       @map("template_id") @db.Uuid
  year            Int
  /// 1-12. Calendars may start at a month other than January.
  startMonth      Int           @default(1) @map("start_month")
  designJson      Json          @map("design_json")
  schemaVersion   Int           @map("schema_version")
  /// Tracked so design growth can be measured against the 500 MB quota (§3.2).
  designBytes     Int           @default(0) @map("design_bytes")
  status          ProjectStatus @default(draft)
  thumbnailKey    String?       @map("thumbnail_key")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Soft delete; hard delete only on a data-deletion request.
  deletedAt       DateTime?     @map("deleted_at") @db.Timestamptz(6)

  profile       Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  productPreset ProductPreset @relation(fields: [productPresetId], references: [id])
  template      Template?     @relation(fields: [templateId], references: [id], onDelete: SetNull)
  assets        ProjectAsset[]

  @@index([userId, deletedAt])
  @@index([productPresetId])
  @@index([templateId])
  @@map("projects")
}

/// An uploaded photo, after processing.
///
/// The original is never kept (P1-US-304): it is decoded, EXIF-stripped and
/// written out as three derivatives, then discarded. Only object keys live here —
/// bytes are in R2 (AR-07).
model ProjectAsset {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// Null while the photo sits in the gallery unattached to a project.
  projectId String?  @map("project_id") @db.Uuid

  storageKeyPrint   String @map("storage_key_print")
  storageKeyPreview String @map("storage_key_preview")
  storageKeyThumb   String @map("storage_key_thumb")

  /// Dimensions of the print derivative, which is what decides print DPI.
  widthPx   Int      @map("width_px")
  heightPx  Int      @map("height_px")
  mime      String
  sizeBytes Int      @map("size_bytes")
  /// What the user called the file, for the gallery. Never used as a path.
  filename  String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  profile Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, deletedAt])
  @@index([projectId])
  @@map("project_assets")
}

model Holiday {
  id   String      @id @default(uuid()) @db.Uuid
  date DateTime    @db.Date
  /// The official Indonesian name, verbatim. Never translated (master §10.7).
  name String
  type HolidayType
  year Int
  /// Rendered red in the grid and printed in the legend.
  isRedDate Boolean  @default(true) @map("is_red_date")
  source    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([date, name])
  @@index([year])
  @@map("holidays")
}

model Setting {
  key       String   @id
  valueJson Json     @map("value_json")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("settings")
}
