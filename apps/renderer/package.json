{
  "name": "@buildcalendar/renderer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:memory": "RENDERER_MEMORY_TEST=1 vitest run test/memory-regression.test.ts"
  },
  "dependencies": {
    "bullmq": "6.1.1",
    "ioredis": "6.0.0",
    "@aws-sdk/client-s3": "^3.1111.0",
    "@buildcalendar/calendar-core": "workspace:*",
    "pdf-lib": "^1.17.1",
    "puppeteer-core": "^24.15.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "dotenv-cli": "11.0.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
