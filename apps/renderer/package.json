    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "bullmq": "6.1.1",
    "ioredis": "6.0.0"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "dotenv-cli": "11.0.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
