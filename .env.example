# BuildCalendar — environment variables
#
# Copy to `.env` and fill in. Every variable in `docs/01-tech-stack-and-infrastructure.md` §6
# is listed here. `.env` is gitignored; never commit real values.
#
# Anything prefixed NEXT_PUBLIC_ is compiled into the browser bundle and is public.
# Everything else is server-only.

# ── App ────────────────────────────────────────────────────────────────────────

# Shown in page titles, emails and the admin panel. Also seeded into `settings`.
SITE_NAME="BuildCalendar"

# Absolute base URL, no trailing slash. Used for links in emails, OAuth redirects
# and signed-URL callbacks. In development: http://localhost:3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Supabase ───────────────────────────────────────────────────────────────────

# Project URL from the Supabase dashboard (Settings → API).
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"

# Anon key. Public by design — it is safe in the browser ONLY because every table
# has RLS enabled with a deny-all policy (§5.3). If a table ships without RLS,
# this key makes it world-readable.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Service-role key. Bypasses RLS entirely — this is the database's master key.
# Server-only. It must never appear in a NEXT_PUBLIC_ variable, a client component,
# or anything that reaches the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=""

# Pooled connection (PgBouncer, port 6543). Used by the application at runtime.
# The `?pgbouncer=true` parameter disables prepared statements and is required —
# without it Prisma fails in confusing ways under the pooler (§5.1).
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (port 5432). Used ONLY by `prisma migrate` and `prisma db seed`.
# Migrations run through the pooler do not behave correctly.
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ── Cloudflare R2 ──────────────────────────────────────────────────────────────
# All photos, PDFs and backups live here, never in Postgres (AR-07).

# Cloudflare account ID; forms the S3 endpoint https://<id>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=""

# R2 API token credentials with read/write on the buckets below.
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# Bucket holding user photos, derivatives, template assets and exported PDFs.
R2_BUCKET="kalender-assets"

# Separate bucket for nightly pg_dump output. Keep its credentials separate from
# the application's in production (§3.4).
R2_BACKUP_BUCKET="kalender-backups"

# Public CDN base URL bound to R2, no trailing slash. Used for thumbnails and
# previews that are safe to serve publicly. Private objects use signed URLs instead.
R2_PUBLIC_BASE_URL="https://cdn.example.com"

# ── Queue ──────────────────────────────────────────────────────────────────────

# BullMQ / Redis. Inside Docker Compose the host is the service name `redis`;
# running the web app on the host against Compose, use redis://localhost:6379.
REDIS_URL="redis://localhost:6379"

# ── Email ──────────────────────────────────────────────────────────────────────
# Supabase's built-in mailer is rate-limited and not for production (§5.2).

# Resend API key (or Brevo equivalent) used as custom SMTP for Supabase Auth
# and for transactional mail sent by the app.
RESEND_API_KEY=""

# From address on outgoing mail. Must be on a domain verified with the provider.
MAIL_FROM="noreply@example.com"

# ── Renderer ───────────────────────────────────────────────────────────────────

# Internal URL of the renderer service. Not publicly exposed; inside Compose this
# is the service name.
RENDERER_URL="http://localhost:4000"

# Shared secret the web app sends and the renderer verifies. Any long random
# string: `openssl rand -hex 32`.
RENDERER_SHARED_SECRET=""

# ── Observability ──────────────────────────────────────────────────────────────

# Sentry DSN. Both `web` and `renderer` report here. Leave empty to disable.
SENTRY_DSN=""

# ── Local development (not in §6) ──────────────────────────────────────────────

# Host port Docker Compose publishes Redis on. Change it if another project on
# your machine already holds 6379; REDIS_URL above must match.
REDIS_PORT="6379"

# Host port Docker Compose publishes the web container on. Compose-only — it does
# not change the port inside the container. For `pnpm dev`, which runs Next on the
# host, prefix the command instead: PORT=3001 pnpm dev
WEB_PORT="3000"

# ── Seeding (not in §6; used only by `pnpm db:seed`) ───────────────────────────

# If both are set, the seed creates this Supabase Auth user and marks its profile
# as an admin. Leave empty to skip admin creation and seed reference data only.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
