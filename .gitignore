# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/
.pnpm-store/

# Build output
# `out/` is anchored so it means the Next.js export directory, not spike/out.
.next/
/out/
apps/*/out/
dist/
build/
.turbo/
*.tsbuildinfo
next-env.d.ts

# Environment — never commit real credentials.
# .env.example is required by P1-US-001 and is deliberately not ignored.
.env
.env.*
!.env.example

# Prisma
prisma/*.db
prisma/*.db-journal
prisma/migrations/dev.db*

# Test and coverage
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/
.playwright/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime and caches
.cache/
.eslintcache
.parcel-cache/
.vercel/
# .rtk/filters.toml is committed config; only its local cache is ignored.
.rtk/cache/

# Editor and OS
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Local Claude Code state (shared skills and settings stay tracked)
.claude/settings.local.json

# --- spike (P1-US-000, throwaway) ---
# Everything here is regenerated by `bash spike/bench.sh`. The measurements that
# matter are written up in spike/REPORT.md, which is tracked.
# Delete the whole directory once docs/DECISIONS.md records the findings.
spike/node_modules/
spike/fixtures/
spike/.tmp/
spike/out/
CLAUDE.md
